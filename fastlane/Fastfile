default_platform :ios
opt_out_usage
skip_docs

require 'json'
require 'net/http'
import 'Sonarfile'

xcode_version = ENV['XCODE_VERSION'] || '26.2'
xcode_project = 'StreamCore.xcodeproj'
sdk_names = ['StreamCore', 'StreamCoreUI', 'StreamAttachments']
github_repo = ENV['GITHUB_REPOSITORY'] || 'GetStream/stream-core-swift'
derived_data_path = 'derived_data'
source_packages_path = 'spm_cache'
swift_environment_path = File.absolute_path("../Sources/#{sdk_names.first}/Utils/SystemEnvironment+Version.swift")
is_localhost = !is_ci
@force_check = false
xcodebuild_formatter = FastlaneCore::Globals.verbose? ? '' : nil

before_all do |lane|
  if is_ci
    setup_ci
    setup_git_config
    select_xcode(version: xcode_version) unless [:sonar_upload, :copyright, :merge_main].include?(lane)
  end
end

desc 'Starts a new release'
lane :release do |options|
  extra_changes = lambda do |release_version|
    # Set the framework version in SystemEnvironment+Version.swift
    old_content = File.read(swift_environment_path)
    current_version = old_content[/version: String = "([^"]+)"/, 1]
    new_content = old_content.gsub(current_version, release_version)
    File.open(swift_environment_path, 'w') { |f| f.puts(new_content) }
  end

  lint_swift_package
  check_unsafe_flags

  release_ios_sdk(
    version: options[:version],
    bump_type: options[:type],
    sdk_names: sdk_names,
    github_repo: github_repo,
    extra_changes: extra_changes,
    create_pull_request: true,
    use_changelog: false
  )
end

lane :merge_release do |options|
  merge_release_to_main(author: options[:author])
  sh('gh workflow run release-publish.yml --ref main')
end

lane :merge_main do
  merge_main_to_develop
  update_release_version_to_snapshot(file_path: swift_environment_path)
  ensure_git_branch(branch: 'develop')
  sh("git add #{swift_environment_path}")
  sh("git commit -m 'Update release version to snapshot'")
  sh('git push')
end

desc 'Completes an SDK Release'
lane :publish_release do |options|
  release_version = get_sdk_version_from_environment
  UI.user_error!("Release #{release_version} has already been published.") if git_tag_exists(tag: release_version, remote: true)
  UI.user_error!('Release version cannot be empty') if release_version.to_s.empty?
  File.write(ENV['GITHUB_ENV'], "RELEASE_VERSION=#{release_version}\n", mode: 'a') if ENV['GITHUB_ENV']

  ensure_git_branch(branch: 'main')

  publish_ios_sdk(
    skip_git_status_check: false,
    version: release_version,
    github_repo: github_repo,
    use_changelog: false
  )
end

lane :get_sdk_version_from_environment do
  File.read(swift_environment_path).match(/String\s+=\s+"([\d.]+).*"/)[1]
end

desc 'Runs StreamCore tests'
lane :test_core do |options|
  options[:scheme] = 'StreamCore'
  options[:sources] = sources_matrix[:core]
  run_library_tests(options)
end

desc 'Runs StreamCoreUI tests'
lane :test_ui do |options|
  options[:scheme] = 'StreamCoreUI'
  options[:sources] = sources_matrix[:ui]
  run_library_tests(options)
end

desc 'Runs StreamAttachments tests'
lane :test_attachments do |options|
  options[:scheme] = 'StreamAttachments'
  options[:sources] = sources_matrix[:attachments]
  run_library_tests(options)
end

private_lane :run_library_tests do |options|
  next unless is_check_required(sources: options[:sources], force_check: @force_check)

  scan_options = {
    project: xcode_project,
    scheme: options[:scheme],
    testplan: options[:scheme],
    clean: is_localhost,
    derived_data_path: derived_data_path,
    cloned_source_packages_path: source_packages_path,
    devices: options[:device],
    skip_build: options[:skip_build],
    build_for_testing: options[:build_for_testing],
    xcodebuild_formatter: xcodebuild_formatter
  }

  scan_with_retries(scan_options: scan_options)

  slather if options[:scheme] == 'StreamCore' && !options[:build_for_testing]
end

# Runs scan and re-runs only the tests that failed, up to `retries` times.
# Every attempt recalculates the failing set from the previous run's result
# bundle, so a shrinking set of flaky tests converges instead of dragging
# the whole suite along.
private_lane :scan_with_retries do |options|
  scan_options = options[:scan_options].merge(result_bundle: true)
  attempts_left = options[:retries] || 3
  retry_number = 0
  Dir.glob(File.expand_path("test_output/#{scan_options[:scheme]}-retry-*.xcresult")).each { |bundle| FileUtils.rm_rf(bundle) }

  begin
    scan(scan_options)
  rescue StandardError
    raise if attempts_left.zero?

    failed_tests = retreive_failed_tests
    raise if failed_tests.empty?

    attempts_left -= 1
    UI.important("Re-running #{failed_tests.size} failed tests ⌛️ (#{attempts_left} retries left)")
    # scan replaces the default result bundle on every run, so each retry keeps its own next to the full first run.
    scan_options = scan_options.merge(
      only_testing: failed_tests,
      clean: false,
      result_bundle_path: File.expand_path("test_output/#{scan_options[:scheme]}-retry-#{retry_number += 1}.xcresult")
    )
    retry
  end
end

# The tests that failed in the last scan, as `Bundle/Suite/test()` for `only_testing`.
# Read from the result bundle rather than scan's junit report: scan skips the report when the
# formatted output lacks a test summary, as xcbeautify's does for Swift Testing, and the report
# names Swift Testing tests by their display names, which `only_testing` doesn't accept.
private_lane :retreive_failed_tests do
  result_bundle_path = lane_context[SharedValues::SCAN_GENERATED_XCRESULT_PATH]
  next [] if result_bundle_path.nil? || !File.directory?(result_bundle_path)

  begin
    results = JSON.parse(sh('xcrun', 'xcresulttool', 'get', 'test-results', 'tests', '--path', result_bundle_path, log: false))
  rescue StandardError => e
    UI.error("Couldn't read the failed tests from #{result_bundle_path}: #{e.message}")
    next []
  end

  failed_tests = []
  collect_failed = lambda do |node, bundle|
    bundle = node['name'] if ['Unit test bundle', 'UI test bundle'].include?(node['nodeType'])
    if node['nodeType'] == 'Test Case'
      failed_tests << "#{bundle}/#{node['nodeIdentifier']}" if node['result'] == 'Failed' && bundle && node['nodeIdentifier']
    else
      node.fetch('children', []).each { |child| collect_failed.call(child, bundle) }
    end
  end
  results.fetch('testNodes', []).each { |node| collect_failed.call(node, nil) }

  failed_tests.uniq
end

desc 'Run fastlane linting'
lane :rubocop do
  next unless is_check_required(sources: sources_matrix[:ruby], force_check: @force_check)

  sh('bundle exec rubocop')
end

desc 'Run PR linting'
lane :lint_pr do
  danger(dangerfile: 'Dangerfile') if is_ci
end

desc 'Run source code formatting/linting'
lane :run_swift_format do |options|
  Dir.chdir('..') do
    strict = options[:strict] ? '--lint' : nil
    sh("swiftformat #{strict} --config .swiftformat .")
    sh("swiftlint lint --config .swiftlint.yml --fix --progress --reporter json") unless strict
    sh("swiftlint lint --config .swiftlint.yml --strict --progress --reporter json")
  end
end

lane :install_runtime do |options|
  install_ios_runtime(version: options[:ios], custom_script: 'Scripts/install_ios_runtime.sh')
end

lane :sources_matrix do
  {
    core: ['Sources/StreamCore/', 'Tests/StreamCoreTests', '.github/workflows/smoke-checks.yml'],
    ui: ['Sources/StreamCoreUI/', 'Tests/StreamCoreUITests', '.github/workflows/smoke-checks.yml'],
    attachments: ['Sources/StreamAttachments/', 'Tests/StreamAttachmentsTests', '.github/workflows/smoke-checks.yml'],
    ruby: ['fastlane', 'Gemfile', 'Gemfile.lock', '.github/workflows/smoke-checks.yml']
  }
end

lane :copyright do
  update_copyright(ignore: [derived_data_path, source_packages_path, 'vendor/'])
  next unless is_ci

  pr_create(
    title: '[CI] Update Copyright',
    head_branch: "ci/update-copyright-#{Time.now.to_i}"
  )
end
